{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumen.local/contracts/document.schema.json",
  "title": "Lumen canonical document v2",
  "description": "Structural schema. Semantic validation additionally enforces unique IDs, allowed parents, rectangular tables, limits, typed attrs, temporal intervals, marks and URI policies. Unknown attrs are retained. Unknown structural fields/types are rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "blocks"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^\\S+$"
        },
        "type": {
          "enum": [
            "paragraph",
            "heading",
            "list_item",
            "quote",
            "group",
            "toggle",
            "code",
            "math",
            "divider",
            "image",
            "object_embed",
            "columns",
            "column",
            "table",
            "table_row",
            "table_cell"
          ]
        },
        "attrs": {
          "type": "object"
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inline"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "heading"
              }
            }
          },
          "then": {
            "required": [
              "attrs"
            ],
            "properties": {
              "attrs": {
                "required": [
                  "level"
                ],
                "properties": {
                  "level": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 6
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "list_item"
              }
            }
          },
          "then": {
            "required": [
              "attrs"
            ],
            "properties": {
              "attrs": {
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "bullet",
                      "decimal",
                      "alpha",
                      "roman",
                      "task"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "toggle"
              }
            }
          },
          "then": {
            "required": [
              "attrs"
            ],
            "properties": {
              "attrs": {
                "required": [
                  "expanded"
                ],
                "properties": {
                  "expanded": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "code"
              }
            }
          },
          "then": {
            "required": [
              "attrs"
            ],
            "properties": {
              "attrs": {
                "required": [
                  "source"
                ],
                "properties": {
                  "source": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "math"
              }
            }
          },
          "then": {
            "required": [
              "attrs"
            ],
            "properties": {
              "attrs": {
                "required": [
                  "source"
                ],
                "properties": {
                  "source": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "image"
              }
            }
          },
          "then": {
            "required": [
              "attrs"
            ],
            "properties": {
              "attrs": {
                "required": [
                  "asset_id"
                ],
                "properties": {
                  "asset_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^\\S+$"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "object_embed"
              }
            }
          },
          "then": {
            "required": [
              "attrs"
            ],
            "properties": {
              "attrs": {
                "required": [
                  "object_id",
                  "view"
                ],
                "properties": {
                  "object_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^\\S+$"
                  },
                  "view": {
                    "enum": [
                      "inline",
                      "link_block",
                      "small_card",
                      "wide_card",
                      "embed"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "table"
              }
            }
          },
          "then": {
            "required": [
              "attrs"
            ],
            "properties": {
              "attrs": {
                "required": [
                  "columns"
                ],
                "properties": {
                  "columns": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "items": {
                      "type": "object",
                      "required": [
                        "id",
                        "width"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128,
                          "pattern": "^\\S+$"
                        },
                        "width": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "columns"
              }
            }
          },
          "then": {
            "properties": {
              "children": {
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/node"
                    },
                    {
                      "properties": {
                        "type": {
                          "const": "column"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "table"
              }
            }
          },
          "then": {
            "properties": {
              "children": {
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/node"
                    },
                    {
                      "properties": {
                        "type": {
                          "const": "table_row"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "table_row"
              }
            }
          },
          "then": {
            "properties": {
              "children": {
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/node"
                    },
                    {
                      "properties": {
                        "type": {
                          "const": "table_cell"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "table_cell"
              }
            }
          },
          "then": {
            "properties": {
              "children": {
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/node"
                    },
                    {
                      "properties": {
                        "type": {
                          "const": "paragraph"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "inline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "text",
            "break",
            "link",
            "object_ref",
            "block_ref",
            "math",
            "temporal"
          ]
        },
        "text": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "href": {
          "type": "string"
        },
        "object_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^\\S+$"
        },
        "block_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^\\S+$"
        },
        "latex": {
          "type": "string",
          "minLength": 1
        },
        "marks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bold": {
              "type": "boolean"
            },
            "italic": {
              "type": "boolean"
            },
            "underline": {
              "type": "boolean"
            },
            "strike": {
              "type": "boolean"
            },
            "code": {
              "type": "boolean"
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
            },
            "highlight": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
            },
            "point_size": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 256
            }
          }
        },
        "attrs": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "link"
              }
            }
          },
          "then": {
            "required": [
              "href"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "object_ref"
              }
            }
          },
          "then": {
            "required": [
              "object_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "block_ref"
              }
            }
          },
          "then": {
            "required": [
              "object_id",
              "block_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "math"
              }
            }
          },
          "then": {
            "required": [
              "latex"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "temporal"
              }
            }
          },
          "then": {
            "required": [
              "attrs"
            ]
          }
        }
      ]
    }
  }
}
