<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Lumen uses HTTP only on 127.0.0.1/USB or a private LAN. HTTPS with
         certificate pinning is supported and preferred for Wi-Fi. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
